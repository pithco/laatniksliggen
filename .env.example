# Laat leeg zolang de nieuwsbrief nog niet is gekoppeld.
# Vul later het formulier-id van MailerLite in. Zet geen geheime sleutel in deze variabele:
# alles met het voorvoegsel PUBLIC_ komt in de website terecht.
PUBLIC_MAILERLITE_FORM_ID=

# Laat leeg om cookieloze analytics uit te laten.
# Voorbeeld als u Plausible aanzet: laatniksliggen.nl
# Pas dan ook de content-security-policy in netlify.toml aan.
PUBLIC_PLAUSIBLE_DOMAIN=
