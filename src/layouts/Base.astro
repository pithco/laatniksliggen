---
import '@fontsource/atkinson-hyperlegible/latin-ext-400.css';
import '@fontsource/atkinson-hyperlegible/latin-ext-700.css';
import '@fontsource/fraunces/latin-ext-600.css';
import '@fontsource/fraunces/latin-ext-700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
const fullTitle = home ? title : `${title} | Laat Niks Liggen`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/check', label: 'Check' },
  { href: '/regelingen', label: 'Regelingen' },
  { href: '/gemeenten', label: 'Gemeenten' },
  { href: '/kalender', label: 'Kalender' },
  { href: '/besparen', label: 'Besparen' },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#083f3b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:url" content={canonical} />
    {plausible && <script defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <a class="skip" href="#inhoud">Naar de inhoud</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
            <circle cx="18" cy="18" r="17" fill="#f4efe6" />
            <circle cx="18" cy="18" r="12" fill="none" stroke="#0e5c56" stroke-width="2" />
            <path d="M12 19.5c1.4 2.2 3.4 3.4 6 3.4s4.6-1.2 6-3.4" fill="none" stroke="#8d3e0c" stroke-width="2" stroke-linecap="round" />
            <circle cx="14" cy="15" r="1.3" fill="#0e5c56" />
            <circle cx="22" cy="15" r="1.3" fill="#0e5c56" />
          </svg>
          Laat Niks Liggen
        </a>
        <nav class="nav" aria-label="Hoofdmenu">
          {links.map((link) => (
            <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="inhoud" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <strong>Geen advies.</strong>
          <p>
            Laat Niks Liggen laat zien welke regelingen er zijn. Wij beslissen niet of u geld krijgt.
            Controleer altijd de officiële bron. Staat er “te controleren” bij, dan is dat feit nog niet hard genoeg.
          </p>
        </div>
        <div>
          <a href="/over">Over deze site</a><br />
          <a href="/privacy">Privacy</a><br />
          <a href="/te-controleren">Te controleren</a>
        </div>
        <div>
          <a href="/besparen">Besparen <span class="badge">reclame</span></a><br />
          <a href="/laat-niks-liggen.ics">Deadlines als agenda</a>
        </div>
      </div>
    </footer>
  </body>
</html>
