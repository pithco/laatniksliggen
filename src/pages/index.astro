---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { formatDatum, loadDeadlines, loadGemeenten, loadRegelingen } from '../lib/content';

const regelingen = loadRegelingen();
const gemeenten = loadGemeenten();
const deadlines = loadDeadlines();
const vandaag = new Date().toISOString().slice(0, 10);
const komend = deadlines.filter((item) => (item.eind ?? item.start) >= vandaag).slice(0, 4);
const description = 'Kijk welke toeslag, belastingteruggaaf of gemeentelijke regeling je misschien laat liggen. Gratis, anoniem, in gewone taal.';
---

<Base title="Laat Niks Liggen — geld dat je kunt aanvragen" description={description} home>
  <section class="hero">
    <div>
      <p class="kicker">Geld dat blijft liggen</p>
      <h1>Er ligt misschien geld op je te wachten.</h1>
      <p class="lede">
        Een toeslag. Belasting terug. Geld op een oude OV-kaart. Of hulp van je gemeente.
        We zetten het op een rij. Jij blijft anoniem.
      </p>
      <p><a class="button" href="/check">Doe de check</a></p>
    </div>
    <div class="stage" aria-hidden="true">
      <article class="card tilt tilt-a">
        <p class="kicker">Voorbeeld</p>
        <h2>Zorgtoeslag</h2>
        <p>Waarschijnlijk. Maximaal € 129 per maand als je alleen bent.</p>
      </article>
      <article class="card tilt tilt-b">
        <p class="kicker">Vraag 4 van 10</p>
        <h2>Huur je zelf een huis?</h2>
        <p>Ja, ik huur</p>
      </article>
    </div>
  </section>

  <aside class="note">
    <strong>Nog dit jaar.</strong>
    Zorgtoeslag, huurtoeslag en kindgebonden budget over 2025 kun je aanvragen tot en met 31 december 2026.
    <a href="/regelingen/zorgtoeslag">Lees hoe dat zit ›</a>
  </aside>

  <div class="actions section">
    <a class="card card-link" href="/regelingen">
      <span class="kicker">{regelingen.length} regelingen</span>
      <h2>Alles op een rij</h2>
      <p>Zoek op toeslag, belasting, vergeten geld of je gemeente.</p>
    </a>
    <a class="card card-link" href="/gemeenten">
      <span class="kicker">{gemeenten.length} gemeenten</span>
      <h2>Je gemeente</h2>
      <p>Bijzondere bijstand, kwijtschelding, een pas en de inkomenstoeslag.</p>
    </a>
    <a class="card card-link" href="/kalender">
      <span class="kicker">Deadlines</span>
      <h2>Zet het in je agenda</h2>
      <p>Download de datums. Geen account nodig.</p>
    </a>
  </div>

  <section class="section">
    <h2>Wat eraan komt</h2>
    <div class="cards">
      {komend.map((item) => (
        <article class="card">
          <p class="kicker">{formatDatum(item.start)}{item.eind ? ` tot ${formatDatum(item.eind)}` : ''}</p>
          <h3>{item.titel}</h3>
          <p>{item.toelichting}</p>
          {!item.zeker && <span class="badge warn">te controleren</span>}
        </article>
      ))}
    </div>
  </section>

  <section class="section split">
    <div>
      <h2>Zo werkt het</h2>
      <ol class="steps">
        <li>Je beantwoordt 10 vragen. Dat blijft in je browser. We sturen niks weg.</li>
        <li>Je ziet welke regelingen kunnen passen, met een link naar de officiële pagina.</li>
        <li>Jij vraagt het zelf aan bij de Belastingdienst, de SVB of je gemeente. We zitten daar niet tussen.</li>
      </ol>
      <p class="disclaimer">
        Dit is geen advies en geen aanvraag. Bedragen veranderen. Kijk op de officiële pagina voor je iets doet.
        Een regeling op deze site is nooit betaald geplaatst.
      </p>
    </div>
    <Newsletter />
  </section>
</Base>
